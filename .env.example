# Environment mode for both backend and frontend: development | production
ENV=development

# --- Frontend (Vite) --------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080

# --- Backend HTTP -----------------------------------------------------------
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

# --- Database (PostgreSQL 16) -----------------------------------------------
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=10

# --- Auth & Rules -----------------------------------------------------------
# Must be >= 32 bytes and unique in production (enforced by ProductionConfigGuard).
JWT_SECRET=
JWT_EXPIRATION_MINUTES=120
ACTIVATION_TOKEN_TTL_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=15
INTERVENTION_THRESHOLD=70

# --- Mail (dev profile) -----------------------------------------------------
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# --- AI (optional) ----------------------------------------------------------
AI_BASE_URL=
