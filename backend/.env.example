# Copy this file to `.env` and adjust values for local development.
# `docker compose` reads `.env` automatically. For Maven runs, export the same
# variables in your shell or set them in your IDE run configuration.

# --- HTTP -------------------------------------------------------------------
SERVER_PORT=8080

# --- Database ---------------------------------------------------------------
# Local Maven + local MySQL:
DB_URL=jdbc:mysql://localhost:3306/aralytics?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# Docker Compose overrides DB_URL to jdbc:mysql://mysql:3306/aralytics?... internally.
DB_USERNAME=aralytics
DB_PASSWORD=aralytics
DB_POOL_SIZE=10
MYSQL_ROOT_PASSWORD=change-me-root

# --- Spring profile ---------------------------------------------------------
# dev  = schema + demo seed + Swagger UI
# prod = schema only, Swagger disabled
SPRING_PROFILES_ACTIVE=dev

# --- Auth -------------------------------------------------------------------
# HS256 signing key. MUST be at least 32 bytes and unique per environment.
JWT_SECRET=dev-only-secret-change-me-in-production-please-0123456789
JWT_EXPIRATION_MINUTES=120

# Issued access keys checked by POST /api/auth/verify-key.
ACTIVATION_STUDENT_KEY=KEY-8821-PY
ACTIVATION_TEACHER_KEY=FAC-2025-DEPED
ACTIVATION_TOKEN_TTL_MINUTES=15

# --- Domain rules -----------------------------------------------------------
# Students whose mastery average is below this percentage are flagged.
INTERVENTION_THRESHOLD=70

# --- CORS -------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- AI (optional) ----------------------------------------------------------
# Only used with the `ai` profile. Empty or unreachable -> mock diagnostic engine.
AI_BASE_URL=
