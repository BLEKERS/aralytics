# Copy this file to `.env.prod` and fill in production values.
# Switch environments locally:
#   Dev + seed:  docker compose --env-file .env up
#   Prod test:   docker compose --env-file .env.prod up

# --- HTTP -------------------------------------------------------------------
SERVER_PORT=8080

# --- Database ---------------------------------------------------------------
# Separate `aralytics_prod` DB keeps prod schema (V1 only) isolated from dev `seed` (V2),
# preventing Flyway validation conflicts when switching between dev and prod locally.
DB_NAME=aralytics_prod
DB_URL=jdbc:postgresql://localhost:5432/aralytics_prod
DB_USERNAME=postgres
DB_PASSWORD=change-me-in-production
DB_POOL_SIZE=10

# --- Spring profile ---------------------------------------------------------
# `prod` disables Swagger UI, disables demo seed data, and enforces ProductionConfigGuard.
SPRING_PROFILES_ACTIVE=prod

# --- Auth -------------------------------------------------------------------
# HS256 signing key. MUST be unique and >= 32 bytes (`ProductionConfigGuard` enforces this).
JWT_SECRET=
JWT_EXPIRATION_MINUTES=120
ACTIVATION_TOKEN_TTL_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=15

# --- Domain rules -----------------------------------------------------------
INTERVENTION_THRESHOLD=70

# --- CORS & Frontend --------------------------------------------------------
# Set to deployed frontend origin(s) in real production.
CORS_ALLOWED_ORIGINS=https://your-production-domain.example
FRONTEND_BASE_URL=https://your-production-domain.example

# --- AI (optional) ----------------------------------------------------------
AI_BASE_URL=
